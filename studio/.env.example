# Публичные значения (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# СЕКРЕТ. Только в переменных окружения Vercel, НЕ в браузерном коде и не в git
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) — для писем «курсқа қолжетімділік ашылды». Пароль/код на почту
# отправляет сам Supabase Auth (см. Authentication → SMTP Settings), сюда не относится.
RESEND_API_KEY=
RESEND_FROM=
SITE_URL=

# ───────── Оплата (docs/PAYMENTS.md) ─────────
# Пусто или kaspi — ручной режим: у курса ссылка Kaspi Pay, админ подтверждает оплату в «Продажах».
# freedom — онлайн через Freedom Pay: курс открывается автоматически после оплаты.
VITE_PAYMENT_PROVIDER=
# СЕКРЕТЫ Freedom Pay — только в переменных окружения Vercel (личный кабинет Freedom Pay → настройки магазина)
FREEDOM_MERCHANT_ID=
FREEDOM_SECRET_KEY=
# 1 — тестовые платежи (тестовые карты Freedom Pay), убрать перед запуском
FREEDOM_TESTING=1
